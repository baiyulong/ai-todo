FROM registry.xpaas.lenovo.com/library/node:20.3.0-alpine
MAINTAINER yanghy24@lenovo.com

RUN mkdir -p /data/server/nodejs-app
WORKDIR /data/server/nodejs-app

# 平台上传的部署包：package.json + package-lock.json + dist/ + frontend/dist/
ADD ["{{files.package.dest}}", "/data/server/nodejs-app"]

# 兼容平台以压缩包交付的情况：包根下若存在 zip 则先解开（不限文件名）
# （如果平台是直接落解压后的目录内容，这一步自动跳过）
RUN for z in *.zip; do [ -f "$z" ] && unzip -qo "$z" && break; done; \
    npm install --omit=dev --registry=https://maven.xpaas.lenovo.com/nexus/repository/npm/

# 运行时配置：数据库等敏感信息由平台环境变量注入（DATABASE_URL 必须）
ENV NODE_ENV=production \
    AI_TODO_HOST=0.0.0.0 \
    AI_TODO_WEB_DIR=/data/server/nodejs-app/frontend/dist \
    AI_TODO_DATA_DIR=/data/server/nodejs-app/data

EXPOSE 8080
CMD [ "npm", "start" ]
