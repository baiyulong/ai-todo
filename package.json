{
  "name": "ai-todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 通过 MCP 推送已完成任务，服务端按规则提醒到桌面浏览器",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "ai-todo": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js serve",
    "dev": "npm run build && node dist/src/cli.js serve",
    "mcp": "node dist/src/cli.js mcp",
    "user": "node dist/src/cli.js user",
    "token": "node dist/src/cli.js token",
    "migrate": "node dist/src/cli.js migrate",
    "test": "npm run build && node --test dist/test/*.test.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  }
}
