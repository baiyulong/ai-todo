# ============================================================
# 复制成 .env 后按需修改（docker compose 会自动读取同目录的 .env）。
# .env 已被 .gitignore 忽略，不会进版本库。
# ============================================================

# ------------------------------------------------------------
# 对外访问
# ------------------------------------------------------------

# 宿主侧监听的端口。改成 8080 就用 http://localhost:8080 访问
AI_TODO_BIND=8787

# 浏览器打开的地址。通知里的深链接按它拼接，
# 所以局域网其它机器访问时要写实际地址，例如 http://192.168.1.20:8787
AI_TODO_PUBLIC_URL=http://localhost:8787

# ------------------------------------------------------------
# PostgreSQL（只有 docker-compose.yml 用到；PGlite 版忽略这几项）
# 密码只用字母数字与下划线——它要拼进连接 URL，
# 含 @ : / # 等字符会破坏 URL 解析
# ------------------------------------------------------------
POSTGRES_USER=ai_todo
POSTGRES_PASSWORD=ai_todo
POSTGRES_DB=ai_todo

# ------------------------------------------------------------
# MCP 客户端
# ------------------------------------------------------------

# 访问令牌。在 Web 端「设置 → 访问令牌」自助签发。
# 只有用 `docker compose run --rm mcp` 在容器里跑 MCP 时才需要填；
# MCP 客户端直接跑在本机时不走这里。
AI_TODO_TOKEN=

# 推送任务的来源标识，会显示在任务卡片上
AI_TODO_SESSION_KEY=docker-mcp
AI_TODO_AGENT=docker-mcp

# 远程 MCP 端点（POST /mcp）。客户端填 URL + Bearer 令牌就能远程接入，
# 本机什么都不用装。改成 off 可关闭该端点。
AI_TODO_MCP_HTTP=on

# ------------------------------------------------------------
# 邮件通知（SMTP）
# 配了 AI_TODO_SMTP_HOST 即启用；留空 = 日志模式，
# 邮件内容打到容器日志，不真发。
# 用途：收到任务发邮件、任务转交通知对方、邮箱绑定验证码。
# 注意：多数云邮箱需要用「授权码」而不是登录密码。
# ------------------------------------------------------------
# SMTP 服务器地址，例如 smtp.qq.com / smtp.163.com / smtp.gmail.com
AI_TODO_SMTP_HOST=
# 端口：465（隐式 TLS，默认）/ 587（STARTTLS）/ 25
AI_TODO_SMTP_PORT=465
# 登录账号与授权码；免认证的内网 SMTP 可以留空
AI_TODO_SMTP_USER=
# 二选一：授权码（推荐）或登录密码。
# QQ 邮箱：设置 → 账号 → 开启 SMTP 服务 → 生成授权码（16 位字母）
# 163 邮箱：设置 → POP3/SMTP/IMAP → 开启并生成授权码
# Gmail：开启两步验证 → 生成应用专用密码
# 两项都填时 AUTH_CODE 优生。
AI_TODO_SMTP_AUTH_CODE=
AI_TODO_SMTP_PASS=
# 发件人，例如 AI Todo <no-reply@example.com>；留空则用 AI Todo <SMTP_USER>
AI_TODO_SMTP_FROM=
# 是否隐式 TLS：on / off。留空按端口推断（465=on，其余=off）
AI_TODO_SMTP_SECURE=

# ------------------------------------------------------------
# 微信登录
# ------------------------------------------------------------
# 两项都填上才启用；留空 = 关闭（登录页不显示微信入口，密码登录照常）。
# 资质门槛见 docs/deployment.md：
#   qrconnect（默认）= 微信开放平台「网站应用」，需企业/个体工商户主体 + 已 ICP 备案域名
#   official            = 公众号网页授权，需已认证公众号
# 个人主体基本走不通这两条路。

AI_TODO_WECHAT_APPID=
AI_TODO_WECHAT_SECRET=

# qrconnect | official
AI_TODO_WECHAT_MODE=qrconnect

# 微信回调地址。必须与微信后台登记的「授权回调域名」一致，且必须是已备案域名：
# localhost / 127.0.0.1 / 局域网 IP 都不能用于真实微信登录。
# 留空则用 AI_TODO_BASE_URL + /api/v1/auth/wechat/callback
AI_TODO_WECHAT_REDIRECT_URI=

# 逗号分隔的 openid 白名单，命中即管理员。改完重启生效。
AI_TODO_WECHAT_ADMIN_OPENIDS=

# 首次微信登录（此前没有账号）时自动签发一枚 MCP 访问令牌
AI_TODO_WECHAT_AUTO_TOKEN=on

# 模拟模式：不连微信官方接口，用假 openid 跑通整条链路。
# 任何人都能用假身份登录本服务，生产环境务必 off。
# 想用手机扫码体验完整流程，请把 AI_TODO_PUBLIC_URL 设成局域网地址。
AI_TODO_WECHAT_MOCK=off

# ------------------------------------------------------------
# 其它
# ------------------------------------------------------------

# info | debug | warn | error
AI_TODO_LOG_LEVEL=info

# 登录态有效期（天）
AI_TODO_SESSION_TTL_DAYS=30

TZ=Asia/Shanghai
