# ============================================================
# 复制成 .env 后按需修改（docker compose 会自动读取同目录的 .env）。
# .env 已被 .gitignore 忽略，不会进版本库。
# ============================================================

# ------------------------------------------------------------
# 对外访问
# ------------------------------------------------------------

# 宿主侧监听的端口。改成 8080 就用 http://localhost:8080 访问
AI_TODO_BIND=8787

# 浏览器打开的地址。通知里的深链接按它拼接，
# 所以局域网其它机器访问时要写实际地址，例如 http://192.168.1.20:8787
AI_TODO_PUBLIC_URL=http://localhost:8787

# ------------------------------------------------------------
# PostgreSQL（只有 docker-compose.yml 用到；PGlite 版忽略这几项）
# 密码只用字母数字与下划线——它要拼进连接 URL，
# 含 @ : / # 等字符会破坏 URL 解析
# ------------------------------------------------------------
POSTGRES_USER=ai_todo
POSTGRES_PASSWORD=ai_todo
POSTGRES_DB=ai_todo

# ------------------------------------------------------------
# MCP 客户端
# ------------------------------------------------------------

# 访问令牌。在 Web 端「设置 → 访问令牌」自助签发。
# 只有用 `docker compose run --rm mcp` 在容器里跑 MCP 时才需要填；
# MCP 客户端直接跑在本机时不走这里。
AI_TODO_TOKEN=

# 推送任务的来源标识，会显示在任务卡片上
AI_TODO_SESSION_KEY=docker-mcp
AI_TODO_AGENT=docker-mcp

# 远程 MCP 端点（POST /mcp）。客户端填 URL + Bearer 令牌就能远程接入，
# 本机什么都不用装。改成 off 可关闭该端点。
AI_TODO_MCP_HTTP=on

# ------------------------------------------------------------
# 其它
# ------------------------------------------------------------

# info | debug | warn | error
AI_TODO_LOG_LEVEL=info

# 登录态有效期（天）
AI_TODO_SESSION_TTL_DAYS=30

TZ=Asia/Shanghai
